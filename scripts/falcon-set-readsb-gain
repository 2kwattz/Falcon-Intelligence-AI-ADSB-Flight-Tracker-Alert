#!/usr/bin/env bash
# Root-owned, narrowly scoped helper for the protected dashboard gain control.
# Install this file as /usr/local/sbin/falcon-set-readsb-gain with root ownership.
set -euo pipefail

readonly CONFIG_FILE="/etc/default/readsb"
readonly BACKUP_FILE="/etc/default/readsb.falcon-gain-backup"

if [[ $# -ne 1 ]]; then
    echo "Usage: falcon-set-readsb-gain <auto|0-59.6>" >&2
    exit 64
fi

gain="$1"

if [[ "$gain" == "auto" ]]; then
    :
elif [[ "$gain" =~ ^([0-9]|[1-5][0-9])([.][0-9])?$ ]] && awk "BEGIN { exit !($gain <= 59.6) }"; then
    :
else
    echo "Gain must be auto or a value between 0 and 59.6 dB." >&2
    exit 64
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "readsb configuration was not found." >&2
    exit 66
fi

temporary_file="$(mktemp "${CONFIG_FILE}.XXXXXX")"
trap 'rm -f "$temporary_file"' EXIT

updated=false
while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == RECEIVER_OPTIONS=\"*\" ]]; then
        options="${line#RECEIVER_OPTIONS=\"}"
        options="${options%\"}"

        if [[ "$options" =~ --gain[[:space:]]+[^[:space:]]+ ]]; then
            options="${options/${BASH_REMATCH[0]}/--gain $gain}"
        elif [[ "$options" =~ --gain=[^[:space:]]+ ]]; then
            options="${options/${BASH_REMATCH[0]}/--gain $gain}"
        else
            options="$options --gain $gain"
        fi

        printf 'RECEIVER_OPTIONS="%s"\n' "$options" >> "$temporary_file"
        updated=true
    else
        printf '%s\n' "$line" >> "$temporary_file"
    fi
done < "$CONFIG_FILE"

if [[ "$updated" != true ]]; then
    echo "RECEIVER_OPTIONS was not found in readsb configuration." >&2
    exit 65
fi

cp --preserve=mode,ownership,timestamps "$CONFIG_FILE" "$BACKUP_FILE"
install --owner=root --group=root --mode=0644 "$temporary_file" "$CONFIG_FILE"

if ! systemctl restart readsb; then
    install --owner=root --group=root --mode=0644 "$BACKUP_FILE" "$CONFIG_FILE"
    systemctl restart readsb || true
    echo "readsb did not restart; the previous configuration was restored." >&2
    exit 1
fi

echo "readsb gain set to $gain"
